# 灵语（LingYu）环境变量示例。
# 复制为 .env 或直接在系统环境变量中设置。桌面端大部分选项在界面里改即可，
# 这些变量主要供 MCP stdio 模式（由 Agent 客户端拉起）使用。

# 接入平台：wechat（桌面微信）/ qq（QQ 机器人官方 API v2）
LINGYU_PLATFORM=wechat

# ---- QQ 机器人（platform=qq 时必填）----
# 在 https://q.qq.com/ 开放平台「开发设置」获取；Token 鉴权已废弃，无需配置。
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
# 可选：自定义 API 域名（默认 https://api.bot.qq.com）
QQ_BOT_API_BASE=
# 可选：Intents 位掩码（0 = GUILDS | GROUP_AND_C2C_EVENT | PUBLIC_GUILD_MESSAGES）
QQ_BOT_INTENTS=0
# 可选：等待网关 READY 的秒数（超时后后台继续重试）
QQ_BOT_CONNECT_TIMEOUT=15

# 自动化后端：auto / wechatauto / wxauto4 / wxauto
WECHAT_BACKEND=auto

# 单次发送最长等待秒数（原项目硬编码 5 秒，向未打开的会话首次发送往往超时）
WECHAT_SEND_TIMEOUT=20

# 连接后是否启动消息监听（读取能力依赖监听）
WECHAT_LISTEN_ON_CONNECT=1

# ---- P1：文件发送白名单 ----
# 允许发送文件的目录，多个用英文逗号分隔。
# 留空表示默认拒绝发送任何文件（更安全），需显式配置才能放宽。
WECHAT_SEND_DIRS=

# 发送前是否需要显式确认（1/0）。开启后未带 confirm=true 的发送仅返回预览。
WECHAT_REQUIRE_CONFIRM=0

# ---- P1：操作审计 ----
# 是否记录操作审计（工具名/目标/时间/结果，不记录聊天正文）
WECHAT_AUDIT_ENABLED=1
# 审计日志路径（默认 <项目根>/logs/audit.jsonl）
WECHAT_AUDIT_LOG=

# ---- P1：会话关注列表预设（运行时可用 set_monitored_chats 增删）----
# 模式：allow（白名单，空=关注全部）/ block（黑名单，优先级更高）
WECHAT_MONITOR_MODE=allow
# 预设白名单，多个用英文逗号分隔
WECHAT_MONITOR_ALLOW=
# 预设黑名单，多个用英文逗号分隔
WECHAT_MONITOR_BLOCK=